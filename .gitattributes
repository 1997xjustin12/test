# core.autocrlf=true misdetects some binaries as text and rewrites their line
# endings on checkout, which corrupts them. Mark binary formats explicitly.
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.mp4  binary
*.webm binary
